<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Njabulo's IT Hub | Official</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --glow: #00f2ff;
            --deep: #050a14;
            --surface: #111a28;
            --text: #ffffff;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; scroll-behavior: smooth; }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--deep);
            color: var(--text);
            line-height: 1.6;
        }

        /* NAVIGATION */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 5%;
            background: rgba(5, 10, 20, 0.95);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 9999;
            border-bottom: 2px solid var(--glow);
        }

        .logo { font-size: 1.8rem; font-weight: 700; color: var(--glow); text-shadow: 0 0 10px var(--glow); }

        .nav-links a {
            color: white;
            margin-left: 15px;
            padding: 8px 15px;
            text-decoration: none;
            border-radius: 5px;
            font-size: 1rem;
            transition: 0.3s;
            border: 1px solid transparent;
        }

        .nav-links a:hover { border-color: var(--glow); color: var(--glow); }

        /* SECTION STYLING */
        section {
            padding: 120px 8% 80px;
            min-height: 100vh;
            border-bottom: 1px solid #1e293b;
        }

        .hero-box {
            text-align: center;
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=1200');
            background-size: cover;
            padding: 100px 20px;
            border-radius: 20px;
            border: 1px solid var(--glow);
        }

        .hero-box h1 { font-size: 3.5rem; margin-bottom: 20px; }

        /* SERVICE GRID */
        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-top: 40px;
        }

        .service-card {
            background: var(--surface);
            padding: 30px;
            border-radius: 15px;
            border-top: 4px solid var(--glow);
            transition: 0.3s;
        }

        .service-card:hover { transform: translateY(-10px); }

        /* BUTTONS */
        .main-btn {
            background: var(--glow);
            color: var(--deep);
            padding: 15px 35px;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            margin-top: 20px;
            font-size: 1rem;
        }

        /* FORMS */
        .form-area {
            max-width: 500px;
            margin: 0 auto;
            background: var(--surface);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 0 20px rgba(0, 242, 255, 0.1);
        }

        input {
            width: 100%;
            padding: 12px;
            margin: 10px 0 20px;
            background: #050a14;
            border: 1px solid #334155;
            color: white;
            border-radius: 8px;
        }

        footer { text-align: center; padding: 60px; background: #03070d; border-top: 1px solid var(--glow); }
    </style>
</head>
<body>

<nav>
    <div class="logo">NJABULO_IT</div>
    <div class="nav-links">
        <a href="#home">Home</a>
        <a href="#services">Services</a>
        <a href="#login">Login</a>
        <a href="#register">Register</a>
    </div>
</nav>

<section id="home">
    <div class="hero-box">
        <h1>Njabulo IT Solutions</h1>
        <p>Professional Cybersecurity, Hardware Repairs, and Web Development.</p>
        <a href="#services" class="main-btn">Get Started Now</a>
    </div>
</section>

<section id="services">
    <h2 style="text-align:center; font-size: 2.5rem; margin-bottom: 10px;">Expert IT Options</h2>
    <p style="text-align:center; color: var(--glow);">High-performance solutions tailored for you.</p>
    
    <div class="service-grid">
        <div class="service-card">
            <h3>🛡️ Security Scan</h3>
            <p>Full device sweep for malware and unauthorized access points.</p>
            <a href="#register" class="main-btn" style="padding: 10px 20px;">Book Scan</a>
        </div>
        <div class="service-card">
            <h3>🚀 PC Tuning</h3>
            <p>Optimize registry and hardware settings for maximum gaming FPS.</p>
            <a href="#register" class="main-btn" style="padding: 10px 20px;">Optimize</a>
        </div>
        <div class="service-card">
            <h3>🌐 Site Design</h3>
            <p>Custom-built interactive websites with modern UI/UX design.</p>
            <a href="#register" class="main-btn" style="padding: 10px 20px;">Build Site</a>
        </div>
    </div>
</section>

<section id="login">
    <div class="form-area">
        <h2 style="text-align:center;">Staff Login</h2>
        <p style="text-align:center; color: #94a3b8; font-size: 0.9rem;">Access the admin dashboard.</p>
        <br>
        <label>Username</label>
        <input type="text" placeholder="Admin Name">
        <label>Password</label>
        <input type="password" placeholder="••••••••">
        <button class="main-btn" style="width:100%" onclick="alert('Access Denied: Please contact Njabulo for admin credentials.')">Login</button>
        <p style="text-align:center; margin-top: 15px; font-size: 0.8rem;">Don't have an account? <a href="#register" style="color: var(--glow);">Register here</a></p>
    </div>
</section>

<section id="register">
    <div class="form-area" style="border-color: #60a5fa;">
        <h2 style="text-align:center;">Client Registration</h2>
        <p style="text-align:center; color: #94a3b8; font-size: 0.9rem;">Join the IT support network.</p>
        <br>
        <label>Full Name</label>
        <input type="text" placeholder="Your Name">
        <label>Email Address</label>
        <input type="email" placeholder="support@njabulo-it.co.za">
        <label>Create Password</label>
        <input type="password" placeholder="••••••••">
        <button class="main-btn" style="width:100%" onclick="alert('Registration Successful! Welcome to Njabulo IT.')">Create Account</button>
    </div>
</section>

<footer>
    <p style="font-weight: 600; color: var(--glow);">Developed & Maintained by Njabulo Shabangu</p>
    <p style="font-size: 0.8rem; color: #64748b; margin-top: 10px;">&copy; 2026 Njabulo IT Solutions. All rights reserved.</p>
</footer>

</body>
</html>
